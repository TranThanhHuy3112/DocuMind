<resources>
    <style name="Theme.DocuMind" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_purple_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_purple</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorSecondaryContainer">@color/accent_purple_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_purple</item>
        <item name="android:colorBackground">@color/workspace_background</item>
        <item name="colorSurface">@color/workspace_surface</item>
        <item name="colorSurfaceVariant">@color/workspace_surface_variant</item>
        <item name="colorOnSurface">@color/workspace_text</item>
        <item name="colorOnSurfaceVariant">@color/workspace_muted</item>
        <item name="colorOutline">@color/workspace_outline</item>
        <item name="colorOutlineVariant">@color/workspace_outline</item>
        <item name="android:windowBackground">@color/workspace_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/workspace_surface</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="Widget.DocuMind.IconButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="ThemeOverlay.DocuMind.Purple" parent="">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_purple_container</item>
